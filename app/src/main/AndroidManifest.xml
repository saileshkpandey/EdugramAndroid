<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Internet permission must be outside the <application> -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EdugramProject"
        tools:targetApi="31">
        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.EdugramProject" />
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ChatbotActivity"
            android:exported="true"
            android:label="Ask Me Your Doubt"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" /> <!-- ✅ Main Activity (entry point) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

        </activity> <!-- Other activities -->
        <activity
            android:name=".CourseListActivity"
            android:exported="false" />
        <activity
            android:name=".CourseDetailActivity"
            android:exported="false" />
        <activity
            android:name=".LessonActivity"
            android:exported="false" />
        <activity
            android:name=".QuizActivity"
            android:exported="false" />
    </application>

</manifest>